{
  "name": "wowtap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "dev:qa": "vite --mode qa --port 4174",
    "maps:audit": "tsx scripts/maps/audit.ts",
    "data:validate": "tsx scripts/data/validate.ts",
    "test:e2e": "playwright test",
    "pages:preflight": "tsx scripts/pages/preflight.ts",
    "schedule:freeze": "tsx scripts/schedule/freeze.ts",
    "verify:qa": "npm run lint && npm run typecheck && npm run test && tsx scripts/maps/audit.ts --fixtures && tsx scripts/data/validate.ts --allow-missing && npm run build && npm run test:e2e && tsx scripts/pages/preflight.ts --qa && npm run pages:smoke",
    "verify": "npm run verify:qa && npm run maps:audit && npm run data:validate && npm run pages:preflight",
    "pages:smoke": "tsx scripts/pages/smoke.ts",
    "local:prepare": "tsx scripts/local/prepare.ts",
    "dev:forever": "vite --mode local-forever --port 4175",
    "publish:prepare": "tsx scripts/pages/stage.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
